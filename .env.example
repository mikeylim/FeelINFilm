# Use either the TMDB API Read Access Token (recommended) or a v3 API key.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: adds IMDb scores and awards summaries where available.
OMDB_API_KEY=

# Optional: adds Letterboxd and Tomatometer scores where available.
MDBLIST_API_KEY=

# Optional: log timings and upstream HTTP status codes.
PROVIDER_METRICS=
